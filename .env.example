# Copy to .env — never commit real values.

# Clerk (identity) — publishable key only; never put CLERK_SECRET_KEY in this file.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Vercel / Next-style name also works at build time if you set it in the dashboard:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase (data + RLS via Clerk JWT template "supabase")
# Dev project ref: duurebydckodwznnmwoc (Lumiq — ask admin for access)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# supabase = live DB (requires sign-in) | mock = demo transcripts only
EXPO_PUBLIC_DATA_SOURCE=supabase
