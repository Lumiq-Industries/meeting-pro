# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never contain real values.
#
# Both come from the Supabase dashboard: Project Settings -> API.
# The anon key is meant to ship inside the app — access is controlled by the
# database's grants and RLS, not by hiding the key.
# Dev project ref: duurebydckodwznnmwoc (Lumiq Industries org — ask Panky for access)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Which data the transcript screens read while the mock is being retired:
#   supabase  (default) — real rows, requires sign-in
#   mock                — src/data/mockData.ts, for side-by-side comparison
# Change it HERE and restart with `npx expo start --clear`. Setting it on the
# command line does not work: in Expo SDK 54 the value in .env wins over the
# shell. Sign-in is required in both modes.
EXPO_PUBLIC_DATA_SOURCE=supabase
