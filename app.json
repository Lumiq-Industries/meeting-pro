{
  "expo": {
    "name": "Meeting Pro",
    "slug": "whatsapp-transcriber",
    "scheme": "meetingpro",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/**"
    ],
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumiqindustries.meetingpro",
      "minimumOsVersion": "16.0",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "package": "com.lumiqindustries.meetingpro",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "name": "Meeting Pro",
      "shortName": "Meeting Pro",
      "description": "WhatsApp Business call transcripts for Lumiq Industries",
      "themeColor": "#0a1628",
      "backgroundColor": "#0a1628"
    },
    "plugins": [
      "expo-asset",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "placeholder-update-before-build"
      }
    },
    "owner": "vilatechorg"
  }
}
